# Copy this file to .env.local for local development.
# On Vercel, add the same keys under Project > Settings > Environment Variables.
# Leave the first two empty to run in preview mode (progress saved in the browser only).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true after you enable Google in Supabase > Authentication > Providers.
VITE_ENABLE_GOOGLE=false

# Optional: only allow sign-ups from one email domain, e.g. example.edu
VITE_ALLOWED_EMAIL_DOMAIN=
